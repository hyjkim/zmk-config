/*
 * Go60 keymap based on the existing Chocofi layout.
 *
 * The Go60 has six columns x four rows per side, three extra keys per side,
 * and three thumb keys per side.  The first three rows preserve the Chocofi
 * letter arrangement; the additional keys provide number-row, punctuation,
 * and navigation fallbacks.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define DEF 0
#define NUM 1
#define SYM 2
#define MAGIC 3
#define NAV 4
#define SET 5

&mt {
  flavor = "tap-preferred";
  tapping-term-ms = <300>;
  quick-tap-ms = <125>;
};

/ {
  input_processors {
    zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
      compatible = "zmk,input-processor-code-mapper";
      #input-processor-cells = <0>;
      type = <INPUT_EV_KEY>;
      map = <INPUT_BTN_0 INPUT_BTN_1>;
    };
  };

  macros {
    rgb_ug_status_macro: rgb_ug_status_macro {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&rgb_ug RGB_STATUS>;
    };

    force_sl1: force_sticky_sl1 {
      label = "JK_force_sticky_sl1";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      bindings = <&to 0>, <&cl1>;
    };

    force_sl2: force_sticky_sl2 {
      label = "JK_force_sticky_sl2";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      bindings = <&to 0>, <&cl2>;
    };
  };

  behaviors {
    magic: magic {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <200>;
      bindings = <&mo>, <&rgb_ug_status_macro>;
    };

    cl1: cl1 {
      compatible = "zmk,behavior-tap-dance";
      label = "TD_LAYER_1";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&sl 1>, <&to 1>;
    };

    cl2: cl2 {
      compatible = "zmk,behavior-tap-dance";
      label = "TD_LAYER_2";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&sl 2>, <&to 2>;
    };

    cl3: cl3 {
      compatible = "zmk,behavior-tap-dance";
      label = "TD_LAYER_3";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&sl 4>, <&to 4>;
    };

    ht: hold_tap {
      compatible = "zmk,behavior-hold-tap";
      label = "HOLD_TAP";
      #binding-cells = <2>;
      tapping-term-ms = <200>;
      quick-tap-ms = <150>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    layer_Base {
      // Chocofi thumb geometry uses T1, T2, and the adjacent R5C2 on each half.
      // LH: R5C2=NUM, T1=SYM, T2=Shift. RH: T2=Ctrl, T1=Space, R5C2=NAV.
      // RH T3 (left of Ctrl) is left-click on every layer; LH T3 stays inactive.
      // Keep the number row and left Tab/Esc/MoErgo.
      // C6..C1 | C1..C6
      // Last two binding rows: LH R5C4,C3,C2 | RH R5C2,C3,C4;
      //                       LH T1,T2,T3   | RH T3,T2,T1.
      bindings = <
        &kp EQUAL  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
        &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T                  &kp Y  &kp U  &kp I  &kp O  &kp P  &none
        &kp ESC    &kp A  &kp S  &kp D  &kp F  &kp G                  &kp H  &kp J  &kp K  &kp L  &kp SQT &none
        &magic MAGIC 0 &kp Z &kp X &kp C &kp V &kp B                  &kp N &kp M &kp COMMA &kp DOT &kp BSPC &none
        &none      &none &cl1                                         &cl3 &none &none
        &cl2       &kp LSHFT &none                                    &mkp LCLK &kp LCTRL &kp SPACE
      >;
    };

    layer_Num {
      // Chocofi number/media layer; the preserved left outer keys fall through
      // to Base so Tab, Esc, and MoErgo remain available on every layer.
      bindings = <
        &none       &none &none &none &none &none                     &none &none &none &none &none &none
        &trans      &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp C_BRI_DN &kp C_BRI_UP &kp KP_MULTIPLY
                                                                        &ht F12 PLUS &ht F7 NUMBER_7 &ht F8 NUMBER_8 &ht F9 NUMBER_9 &none &none
        &trans      &none &kp EQUAL &kp COLON &none &kp KP_DIVIDE       &ht F11 MINUS &ht F4 NUMBER_4 &ht F5 NUMBER_5 &ht F6 NUMBER_6 &kp ENTER &none
        &trans      &kp TAB &kp C_PLAY_PAUSE &kp C_NEXT &kp PERIOD &kp KP_EQUAL
                                                                        &ht F10 PERIOD &ht F1 NUMBER_1 &ht F2 NUMBER_2 &ht F3 NUMBER_3 &trans &none
        &none       &none &cl1                                       &cl3 &none &none
        &cl2        &kp LSHFT &none                                  &mkp LCLK &mt LCTRL NUMBER_0 &to DEF
      >;
    };

    layer_Sym {
      // Chocofi symbol layer on the same letter and thumb positions.
      bindings = <
        &none       &none &none &none &none &none                     &none &none &none &none &none &none
        &trans      &kp TILDE &none &none &kp LEFT_PARENTHESIS &none    &none &kp RIGHT_PARENTHESIS &kp PLUS &kp QMARK &kp PIPE &none
        &trans      &kp GRAVE &kp EQUAL &kp COLON &kp LEFT_BRACE &kp LT  &kp GT &kp RIGHT_BRACE &kp MINUS &kp UNDER &kp DOUBLE_QUOTES &none
        &trans      &kp TAB &none &kp SEMI &kp LEFT_BRACKET &none       &none &kp RIGHT_BRACKET &trans &trans &trans &none
        &none       &none &force_sl1                                 &cl3 &none &none
        &cl2        &kp LSHFT &none                                  &mkp LCLK &sk LCTRL &to DEF
      >;
    };

    layer_Magic {
      // Go60 hardware controls. MoErgo on Base taps status and holds this layer.
      bindings = <
        &bt BT_CLR &kp C_BRI_DN &kp C_BRI_UP &kp C_PREV &kp C_NEXT &kp C_PLAY_PAUSE    &kp C_MUTE &kp C_VOLUME_DOWN &kp C_VOLUME_UP &none &none &bt BT_CLR_ALL
        &bootloader &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG    &none &none &none &none &none &bootloader
        &sys_reset &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF    &none &none &none &none &none &sys_reset
        &none &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3    &none &none &none &none &none &to DEF
        &out OUT_USB &none &none                                      &none &none &none
        &none &none &none                                      &mkp LCLK &none &none
      >;
    };

    layer_Nav {
      // Navigation and editing layer from the Chocofi configuration.
      // F/G keep Cmd+[/] navigation; M/comma switch desktops with Ctrl+Left/Right.
      bindings = <
        &none &none &none &none &none &none                         &none &none &none &none &none &none
        &trans &none &none &kp LA(RIGHT_ARROW) &kp LG(LS(Z)) &none    &kp LG(C) &kp LG(Z) &to DEF &kp DEL &kp LG(V) &none
        &trans &none &ht LG(LS(N4)) LG(LC(LS(N4))) &kp LG(X) &kp LG(LEFT_BRACKET) &kp LG(RIGHT_BRACKET)    &kp LEFT_ARROW &kp DOWN_ARROW &kp UP_ARROW &kp RIGHT_ARROW &kp ENTER &none
        &trans &kp TAB &kp DEL &none &none &kp LA(LEFT_ARROW)    &kp LC(UP_ARROW) &kp LC(LEFT_ARROW) &kp LC(RIGHT_ARROW) &none &trans &none
        &none &none &force_sl1                                 &cl3 &none &none
        &cl2 &kp LSHFT &none                                   &mkp LCLK &sk LCTRL &to DEF
      >;
    };

    layer_Set {
      // Bluetooth controls.  The three-key chords below mirror the Chocofi
      // setup layer while leaving the rest of this layer inert.
      bindings = <
        &none &none &none &none &none &none    &none &none &none &none &none &none
        &trans &none &none &none &none &none    &none &bt BT_SEL 0 &bt BT_PRV &bt BT_NXT &none &none
        &trans &none &none &none &none &none    &none &none &none &none &none &none
        &trans &none &none &none &none &none    &none &none &none &none &none &none
        &none &none &force_sl1                                 &cl3 &none &none
        &cl2 &kp LSHFT &none                                   &mkp LCLK &sk LCTRL &to DEF
      >;
    };
  };

  combos {
    compatible = "zmk,combos";

    combo_esc {
      key-positions = <25 37>;
      bindings = <&kp ESC>;
      timeout-ms = <30>;
    };

    combo_ret {
      key-positions = <45 46>;
      bindings = <&kp RET>;
      timeout-ms = <30>;
    };

    combo_ret_2 {
      key-positions = <44 45>;
      bindings = <&kp RET>;
      timeout-ms = <35>;
    };

    combo_tab {
      key-positions = <37 38>;
      bindings = <&kp TAB>;
      timeout-ms = <35>;
    };

    combo_tab_2 {
      key-positions = <38 39>;
      bindings = <&kp TAB>;
      timeout-ms = <30>;
    };

    left_command {
      bindings = <&kp LEFT_COMMAND>;
      key-positions = <27 28>;
      timeout-ms = <30>;
    };

    left_alt {
      bindings = <&kp LEFT_ALT>;
      key-positions = <28 26>;
      timeout-ms = <30>;
    };

    left_alt_cmd {
      bindings = <&kp LG(LEFT_ALT)>;
      key-positions = <28 27 26>;
      timeout-ms = <30>;
    };

    right_command {
      bindings = <&kp RIGHT_COMMAND>;
      key-positions = <31 32>;
      timeout-ms = <30>;
    };

    right_alt {
      bindings = <&kp RIGHT_ALT>;
      key-positions = <31 33>;
      timeout-ms = <30>;
    };

    right_alt_cmd {
      bindings = <&kp RG(RIGHT_ALT)>;
      key-positions = <31 32 33>;
      timeout-ms = <30>;
    };

    start_of_line {
      bindings = <&kp LG(RIGHT_ARROW)>;
      key-positions = <16 28>;
      layers = <NAV>;
      timeout-ms = <30>;
    };

    end_of_line {
      bindings = <&kp LG(LEFT_ARROW)>;
      key-positions = <18 30>;
      layers = <NAV>;
      timeout-ms = <30>;
    };

    to_set {
      bindings = <&to SET>;
      key-positions = <14 15 16>;
      layers = <NAV>;
      timeout-ms = <30>;
    };

    bt_clr {
      bindings = <&bt BT_CLR>;
      key-positions = <19 20 21>;
      layers = <SET>;
      timeout-ms = <30>;
    };

    cb_excl {
      bindings = <&kp EXCL>;
      key-positions = <13 25>;
      timeout-ms = <30>;
    };

    cb_at {
      bindings = <&kp AT>;
      key-positions = <14 26>;
      timeout-ms = <30>;
    };

    cb_hash {
      bindings = <&kp HASH>;
      key-positions = <15 27>;
      timeout-ms = <30>;
    };

    cb_dllr {
      bindings = <&kp DLLR>;
      key-positions = <16 28>;
      timeout-ms = <30>;
      layers = <DEF NUM SYM>;
    };

    cb_prcnt {
      bindings = <&kp PRCNT>;
      key-positions = <17 29>;
      timeout-ms = <30>;
    };

    cb_caret {
      bindings = <&kp CARET>;
      key-positions = <18 30>;
      timeout-ms = <30>;
      layers = <DEF NUM SYM>;
    };

    cb_amps {
      bindings = <&kp AMPS>;
      key-positions = <19 31>;
      timeout-ms = <30>;
    };

    cb_mult {
      bindings = <&kp KP_MULTIPLY>;
      key-positions = <20 32>;
      timeout-ms = <30>;
    };

    cb_slash {
      bindings = <&kp SLASH>;
      key-positions = <21 33>;
      timeout-ms = <30>;
    };

    cb_bslash {
      bindings = <&kp BACKSLASH>;
      key-positions = <22 34>;
      timeout-ms = <30>;
    };

    cb_tilde {
      bindings = <&kp TILDE>;
      key-positions = <13 14>;
      timeout-ms = <30>;
    };

    // Typeless dictation: apostrophe + backspace sends the app's additional F16 shortcut.
    typeless {
      bindings = <&kp F16>;
      key-positions = <34 46>;
      layers = <DEF>;
      timeout-ms = <30>;
    };
  };
};

// Go60 touchpads: the right pad is a mouse, while the left pad scrolls and
// uses its click as right-click.  The Symbol layer increases right-pad speed.
&cirque_rh_listener {
  input-processors = <&zip_xy_scaler 3 1>;

  layer_2 {
    layers = <SYM>;
    input-processors = <&zip_xy_scaler 9 1>;
  };
};

&cirque_lh_listener {
  // Map motion to wheel events before scaling them. An XY scaler here would
  // ignore the mapped events, leaving scrolling at full speed.
  input-processors = <&zip_xy_to_scroll_mapper>,
                     <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
                     <&zip_scroll_scaler 1 16>,
                     <&zip_click_to_right_click_mapper>;

  layer_4 {
    layers = <SET>;
    input-processors = <&zip_xy_scaler 3 1>;
  };

  nav_scroll {
    layers = <NAV>;
    // Layer overrides replace the whole chain: retain natural scrolling and
    // right-click while scrolling twice as fast as the normal setting.
    input-processors = <&zip_xy_to_scroll_mapper>,
                       <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
                       <&zip_scroll_scaler 1 8>,
                       <&zip_click_to_right_click_mapper>;
  };
};
